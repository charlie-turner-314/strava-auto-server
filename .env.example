# Strava OAuth: create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# For pure LAN dev, use the API container callback (adjust if browsing from another device)
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/strava/callback

# Database (SQLite path or DSN)
DATABASE_URL=sqlite:///./data/app.db

# Geocoding (Nominatim)
# Provide a real contact email per Nominatim usage policy
GEOCODE_CONTACT_EMAIL=

# Optional
# POLLING_INTERVAL_SEC=120
# INITIAL_BACKFILL_DAYS=30
